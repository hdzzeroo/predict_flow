# Multi-Agent Traffic Prediction System Environment Variables

# OpenAI API Configuration
OPENAI_API_KEY=your_openai_api_key_here

# Alternative LLM API Keys (optional)
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# System Configuration (optional - overrides config.yaml)
# DATA_PATH=./data
# OUTPUT_PATH=./output
# LOG_LEVEL=INFO

# Testing Configuration (optional)
# TESTING=false
# PYTHON_ENV=production

# Note: Copy this file to .env and fill in your actual API keys
# The .env file is automatically loaded when the system starts