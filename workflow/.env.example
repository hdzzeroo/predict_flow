# OpenAI API 設定
# OpenAI APIキーを設定（必須：LLMを使用する場合）
OPENAI_API_KEY=sk-your-api-key-here

# 使用するモデル（オプション、デフォルト: gpt-4o）
# OPENAI_MODEL=gpt-4o
# OPENAI_MODEL=gpt-4o-mini

# LLM設定（オプション）
# true: 実際のLLM APIを使用
# false: ローカルの正規表現解析を使用
USE_REAL_LLM=true

# データパス設定（オプション）
# 絶対パスで指定する場合
# DATA_BASE_DIR=/path/to/your/data

# 相対パスを使用する場合（デフォルト）
# DATA_BASE_DIR=
